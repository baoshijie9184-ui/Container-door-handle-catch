# 可选模型配置片段，需合并到已有私有环境文件；不替代完整 cloud.env。
# 这些名称来自既有接入目录，不代表安装/合并时仍有免费额度。
# 启用前分别核对百炼控制台额度，并保持各模型“免费额度用完即停”。
# 不包含直连付费供应商，不改变 Key、网关、账号权限或向量模型。
AGENTSCOPE_AI_MODEL=dashscope:deepseek-v4.1-flash
DASHSCOPE_MODEL=deepseek-v4.1-flash
DASHSCOPE_ADDITIONAL_MODELS=qwen3.8-max-0902,glm-5.3
AGENT_MODEL_FALLBACK_ENABLED=true
AGENT_MODEL_FALLBACK_MODELS=dashscope:deepseek-v4.1-flash
AGENT_MODEL_ADDITIONAL_FALLBACK_MODELS=dashscope:qwen3.8-max-0902,dashscope:glm-5.3

# 提炼独立选择，不自动重放原 Flash 的未知/失败写入请求。
# 同步核对该模型是否已在实际网关中登记，保留原 EMBEDDING_* 配置。
MEM0_LLM_MODEL=qwen3.8-max-0902
