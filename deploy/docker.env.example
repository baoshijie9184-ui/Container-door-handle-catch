# -------------------- 数据库 --------------------
DB_URL=jdbc:mysql://host.docker.internal:3306/doorhandledb?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=utf8mb4
DB_USERNAME=root
DB_PASSWORD=replace-with-database-password

# -------------------- Redis --------------------
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-password

# -------------------- Kafka / 检测 worker --------------------
APP_KAFKA_ENABLED=true
APP_KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
APP_REPORT_EVENTS_ENABLED=false
APP_DETECTION_WORKER_ENABLED=true
APP_DETECTION_WORKER_DEPLOYMENT=remote
APP_DETECTION_WORKER_LABEL=remote-python-worker

# -------------------- 外部记忆服务 --------------------
MEM0_SERVICE_URL=http://host.docker.internal:8081
MEM0_ENABLED=false
MEM0_BRIDGE_TOKEN=
CHAT_ASSISTANT_CHROMA_ENABLED=false
CHAT_ASSISTANT_CHROMA_BASE_URL=http://host.docker.internal:8000

# -------------------- 身份认证 --------------------
JWT_SECRET=replace-with-at-least-32-random-characters
APP_COOKIE_SECURE=false
# 必须填写浏览器实际访问的源，包含自定义端口；使用 HTTPS 后同时设 secure=true。
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8088,http://localhost:8088
APP_BUSINESS_SEED_ENABLED=false
APP_REDIS_ENABLED=true

# -------------------- 大语言模型 --------------------
AGENTSCOPE_AI_ENABLED=false
AGENTSCOPE_AI_MODEL=dashscope:qwen-plus
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AGENT_RESPONSES_BASE_URL=https://api.openai.com/v1
AGENT_RESPONSES_STORE=false
AGENT_MODEL_FALLBACK_ENABLED=false
AGENT_MODEL_FALLBACK_MODELS=

# 开启前先显式执行对应迁移，勿使用 Windows 宿主机的绝对路径。
AGENTSCOPE_AI_WORKSPACE=/app/.agentscope/workspace
AGENT_WORKSPACE_ROOT=/app/.agentscope/workspace
AGENT_RUN_JOURNAL_ENABLED=false
AGENT_ACTION_CONFIRMATION_ENABLED=false
AGENT_SKILL_EVOLUTION_ENABLED=false
AGENT_SKILL_LINK_ENABLED=false
AGENT_SKILL_LINK_PYTHON=/usr/bin/python3
AGENT_LOCAL_MCP_ENABLED=false
AGENT_LOCAL_MCP_PYTHON=/usr/bin/python3

# -------------------- 阿里云 OSS --------------------
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=replace-with-oss-bucket
ALIYUN_OSS_ACCESS_KEY_ID=replace-with-oss-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=replace-with-oss-access-key-secret

# -------------------- JVM --------------------
# Compose 为后端分配 3GiB，堆上限 60%，其余留给原生推理库与 Python 子进程。
JAVA_OPTS=-XX:InitialRAMPercentage=15 -XX:MaxRAMPercentage=60 -Djava.awt.headless=true
