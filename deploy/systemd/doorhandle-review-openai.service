[Unit]
Description=Forward review TLS connections to the OpenAI API through the local HTTP proxy

[Service]
EnvironmentFile=%h/.config/doorhandle/review-openai-relay.env
ExecStart=/usr/bin/python3 -B %h/.local/lib/doorhandle/review-openai-proxy.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
