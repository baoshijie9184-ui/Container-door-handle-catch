# 与 compose.monolith.yml + compose.cloud.yml 使用。先填写所有凭据，再启动。
DOORHANDLE_ENV_FILE=deploy/cloud.env
APP_IMAGE_TAG=local
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=8088

MYSQL_ROOT_PASSWORD=replace-with-random-root-password
MYSQL_DATABASE=doorhandledb
MYSQL_USER=doorhandle
MYSQL_PASSWORD=replace-with-random-app-password
# DB_PASSWORD 必须与 MYSQL_PASSWORD 相同。
DB_URL=jdbc:mysql://mysql:3306/doorhandledb?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=doorhandle
DB_PASSWORD=replace-with-random-app-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-random-redis-password
APP_REDIS_ENABLED=true
APP_KAFKA_ENABLED=true
APP_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
APP_REPORT_EVENTS_ENABLED=false
# 默认仅启动应用；验收 PTH 模型后叠加 compose.detection.yml 启用检测 worker。
APP_DETECTION_WORKER_ENABLED=false
APP_DETECTION_WORKER_DEPLOYMENT=remote
APP_DETECTION_WORKER_LABEL=remote-python-worker
# 真实模型验收后再叠加 compose.detection.yml，并填写以下变量。
# DETECTION_MODEL_ID=模型管理中发布后的真实编号
# DETECTION_MODELS_DIR=/srv/doorhandle/models
# DETECTION_BUILD_CONTEXT=./work/cloud/pth-worker-build
# DETECTION_MODEL_GID=1000
# DETECTION_CPU_THREADS=2

JWT_SECRET=replace-with-at-least-32-random-characters
APP_COOKIE_SECURE=false
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8088,http://localhost:8088
APP_BUSINESS_SEED_ENABLED=false

# 启用前先导入已迁移的数据库，或按 sql/mysql/README.md 初始化。
AGENTSCOPE_AI_ENABLED=false
AGENTSCOPE_AI_MODEL=dashscope:qwen-plus
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AGENT_RESPONSES_BASE_URL=https://api.openai.com/v1
AGENT_RESPONSES_STORE=false
AGENT_MODEL_FALLBACK_ENABLED=false
AGENT_MODEL_FALLBACK_MODELS=

AGENTSCOPE_AI_WORKSPACE=/app/.agentscope/workspace
AGENT_WORKSPACE_ROOT=/app/.agentscope/workspace
AGENT_RUN_JOURNAL_ENABLED=false
# Enable after migration-V31-agent-research-evidence.sql; private excerpts are kept for 30-day access.
AGENT_RESEARCH_EVIDENCE_ENABLED=false
# Requires V33; audited private source export is opt-in.
AGENT_RESEARCH_EXPORT_ENABLED=false
AGENT_CONVERSATION_CONTROL_ENABLED=false
AGENT_WORKBENCH_ENABLED=false
AGENT_WORKBENCH_MAX_FILE_BYTES=26214400
AGENT_WORKBENCH_QUOTA_BYTES=524288000
AGENT_WORKBENCH_PREVIEW_BYTES=64000
AGENT_RESEARCH_EXPORT_RATE_LIMIT_ENABLED=false
AGENT_RESEARCH_EXPORT_MAX_PER_WINDOW=5
AGENT_RESEARCH_EXPORT_WINDOW_SECONDS=60
# Optional in-run summarization; uses the existing model provider and may add model requests.
AGENT_CONTEXT_COMPACTION_ENABLED=false
AGENT_CONTEXT_TRIGGER_MESSAGES=32
AGENT_CONTEXT_TRIGGER_TOKENS=24000
AGENT_CONTEXT_KEEP_MESSAGES=6
AGENT_CONTEXT_MAX_SUMMARY_CHARS=6000
AGENT_CONTEXT_TIMEOUT_SECONDS=12
AGENT_CONTEXT_MAX_PER_RUN=3
# V32: opt-in account quota; expired display content is cleared only when purge is also enabled.
AGENT_RESEARCH_STORAGE_GOVERNANCE_ENABLED=false
AGENT_RESEARCH_MAX_SOURCES_PER_USER=500
AGENT_RESEARCH_EXPIRED_CONTENT_PURGE_ENABLED=false
AGENT_RESEARCH_CLEANUP_BATCH_SIZE=100
AGENT_RESEARCH_CLEANUP_DELAY_MS=60000
AGENT_ACTION_CONFIRMATION_ENABLED=false
AGENT_SKILL_EVOLUTION_ENABLED=false
AGENT_SKILL_LINK_ENABLED=false
AGENT_SKILL_LINK_PYTHON=/usr/bin/python3
AGENT_SKILL_LINK_INSTALLER=/app/script/shell/download-linked-skill.py
AGENT_LOCAL_MCP_ENABLED=false
# 先执行 V34；持久安装队列默认关闭
AGENT_MCP_DURABLE_INSTALL_ENABLED=false
AGENT_LOCAL_MCP_PYTHON=/usr/bin/python3
AGENT_LOCAL_MCP_INSTALLER=/app/script/shell/install-local-fetch-mcp.py
# Optional compose.ai-gateway.yml: provision these server-only values first.
AGENT_MCP_TRANSPORT=STDIO
AGENT_MCP_GATEWAY_SECRET=
AGENT_MCP_GATEWAY_KEY=
MCP_FETCH_IMAGE=
MCP_EGRESS_IMAGE=
MCP_DOCKER_GID=
MCP_SERVER_PUBLIC_IPS=
# Without the overlay the direct provider route remains active.
AGENT_MODEL_GATEWAY_BASE_URL=

# Mem0 容器启动时需要有效的 LLM/Embedding 配置；不随应用镜像打包密钥。
MEM0_ENABLED=true
MEM0_SERVICE_URL=http://mem0:8081
MEM0_BRIDGE_TOKEN=replace-with-random-memory-bridge-token
MEM0_DATA_DIR=/data
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
CHAT_ASSISTANT_CHROMA_ENABLED=true
CHAT_ASSISTANT_CHROMA_BASE_URL=http://chroma:8000

ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=replace-with-oss-bucket
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
OSS_UPLOAD_HOST=replace-with-oss-bucket.oss-cn-beijing.aliyuncs.com
JAVA_OPTS=-XX:InitialRAMPercentage=15 -XX:MaxRAMPercentage=60 -Djava.awt.headless=true
