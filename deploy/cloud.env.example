# 与 compose.monolith.yml + compose.cloud.yml 使用。先填写所有凭据，再启动。
# 检测模型文件意图与保留记录：需 V53 和 OPERATIONS_AUDIT_ENABLED，验收前关闭。
MODEL_FILE_JOURNAL_ENABLED=false
# 分派操作人和身份事件：依赖 V40/V54、稳定身份服务与必要业务审计，验收前关闭。
DETECTION_ASSIGNMENT_BINDING_ENABLED=false
# 历史账号回填 v2：需 V40/V55、稳定身份服务和必要审计；默认关闭。
DETECTION_IDENTITY_REVIEW_ENABLED=false
# 身份来源保护：依赖 V40/V55/V56、回填确认和必要审计；不得把旧对齐字段当作来源证据。
DETECTION_IDENTITY_EVIDENCE_ENABLED=false
# 缺失历史名称的明确资料核对：需 V61、回填/来源服务和兼容恢复基线，保留原名称不改写。
DETECTION_IDENTITY_MISSING_NAME_REVIEW_ENABLED=false
# 历史/重升级身份快照核对：需 V40/V55/V56/V57 和来源服务，仅保存报告，不修改任务。
DETECTION_IDENTITY_RECONCILIATION_ENABLED=false
DETECTION_IDENTITY_RECONCILIATION_MAX_TASKS=20000
DETECTION_IDENTITY_RECONCILIATION_MAX_REPORTS=20
# 兼容基线可暂停分派写入，保留读取、拒绝和取消确认；不是全站只读开关。
DETECTION_ASSIGNMENT_WRITES_ENABLED=true
DOORHANDLE_ENV_FILE=deploy/cloud.env
APP_IMAGE_TAG=local
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=8088

MYSQL_ROOT_PASSWORD=replace-with-random-root-password
MYSQL_DATABASE=doorhandledb
MYSQL_USER=doorhandle
MYSQL_PASSWORD=replace-with-random-app-password
# DB_PASSWORD 必须与 MYSQL_PASSWORD 相同。
DB_URL=jdbc:mysql://mysql:3306/doorhandledb?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=doorhandle
DB_PASSWORD=replace-with-random-app-password
# 检测命令/事务消息与 worker MySQL 回执一起启用；V42 与完整候选验收前保持 false。
DETECTION_EXECUTION_COMMANDS_ENABLED=false
# Requires V43, workbench files, action confirmations, operations audit and command receipts. Enable only after final acceptance.
DETECTION_AGENT_CREATION_ENABLED=false
DETECTION_AGENT_BUSINESS_IMAGES_ENABLED=false
DETECTION_CREATION_TRANSFER_EVIDENCE_ENABLED=false
DETECTION_CREATION_REVIEW_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-random-redis-password
APP_REDIS_ENABLED=true
# Additive V63/V64/V65 must be applied before enabling these features.
APP_KNOWLEDGE_ENABLED=false
APP_MODEL_BUDGET_ENABLED=false
APP_QUALITY_AUTOMATION_ENABLED=false
APP_QUALITY_AUTOMATION_POLL_MS=30000
APP_QUALITY_AUTOMATION_TASK_TIME_ZONE=UTC
APP_KAFKA_ENABLED=true
APP_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
APP_REPORT_EVENTS_ENABLED=false
# 默认仅启动应用；验收 PTH 模型后叠加 compose.detection.yml 启用检测 worker。
APP_DETECTION_WORKER_ENABLED=false
APP_DETECTION_WORKER_DEPLOYMENT=remote
APP_DETECTION_WORKER_LABEL=remote-python-worker
# 真实模型验收后再叠加 compose.detection.yml，并填写以下变量。
# DETECTION_MODEL_ID=模型管理中发布后的真实编号
# DETECTION_MODELS_DIR=/srv/doorhandle/models
# DETECTION_BUILD_CONTEXT=./work/cloud/pth-worker-build
# DETECTION_MODEL_GID=1000
# DETECTION_CPU_THREADS=2

JWT_SECRET=replace-with-at-least-32-random-characters
APP_COOKIE_SECURE=false
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8088,http://localhost:8088
APP_BUSINESS_SEED_ENABLED=false

# 启用前先导入已迁移的数据库，或按 sql/mysql/README.md 初始化。
AGENTSCOPE_AI_ENABLED=false
AGENTSCOPE_AI_MODEL=dashscope:qwen-plus
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
# 同一百炼 Key 可登记多个模型；仅填写控制台确认可用的模型，最多含主模型 16 个。
DASHSCOPE_ADDITIONAL_MODELS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AGENT_RESPONSES_BASE_URL=https://api.openai.com/v1
AGENT_RESPONSES_STORE=false
AGENT_MODEL_FALLBACK_ENABLED=false
AGENT_MODEL_FALLBACK_MODELS=
# 扩展备用项；旧镜像忽略该变量，基础备用列表应保持与回滚版本兼容。
AGENT_MODEL_ADDITIONAL_FALLBACK_MODELS=

AGENTSCOPE_AI_WORKSPACE=/app/.agentscope/workspace
AGENT_WORKSPACE_ROOT=/app/.agentscope/workspace
AGENT_RUN_JOURNAL_ENABLED=false
# Enable after migration-V31-agent-research-evidence.sql; private excerpts are kept for 30-day access.
AGENT_RESEARCH_EVIDENCE_ENABLED=false
# Requires V33; audited private source export is opt-in.
AGENT_RESEARCH_EXPORT_ENABLED=false
AGENT_CONVERSATION_CONTROL_ENABLED=false
AGENT_WORKBENCH_ENABLED=false
AGENT_WORKBENCH_MAX_FILE_BYTES=26214400
AGENT_WORKBENCH_QUOTA_BYTES=524288000
AGENT_WORKBENCH_PREVIEW_BYTES=64000
AGENT_RESEARCH_EXPORT_RATE_LIMIT_ENABLED=false
AGENT_RESEARCH_EXPORT_MAX_PER_WINDOW=5
AGENT_RESEARCH_EXPORT_WINDOW_SECONDS=60
# Optional in-run summarization; uses the existing model provider and may add model requests.
AGENT_CONTEXT_COMPACTION_ENABLED=false
# V44 + V45; requires workbench + recovery + compaction. Keep disabled until final integrated acceptance.
AGENT_DURABLE_CONTEXT_ENABLED=false
AGENT_CONTEXT_OFFLOAD_ENABLED=false
AGENT_CONTEXT_TRIGGER_MESSAGES=32
AGENT_CONTEXT_TRIGGER_TOKENS=24000
AGENT_CONTEXT_KEEP_MESSAGES=6
AGENT_CONTEXT_MAX_SUMMARY_CHARS=6000
AGENT_CONTEXT_TIMEOUT_SECONDS=12
AGENT_CONTEXT_MAX_PER_RUN=3
# V32: opt-in account quota; expired display content is cleared only when purge is also enabled.
AGENT_RESEARCH_STORAGE_GOVERNANCE_ENABLED=false
AGENT_RESEARCH_MAX_SOURCES_PER_USER=500
AGENT_RESEARCH_EXPIRED_CONTENT_PURGE_ENABLED=false
AGENT_RESEARCH_CLEANUP_BATCH_SIZE=100
AGENT_RESEARCH_CLEANUP_DELAY_MS=60000
AGENT_ACTION_CONFIRMATION_ENABLED=false
AGENT_SKILL_EVOLUTION_ENABLED=false
# Linked Skill runtime requires V27/V28/V29 and V46; unknown process exits retain quota.
AGENT_SKILL_LINK_ENABLED=false
AGENT_SKILL_LINK_QUOTA_BYTES=67108864
AGENT_SKILL_LINK_PYTHON=/usr/bin/python3
AGENT_SKILL_LINK_INSTALLER=/app/script/shell/download-linked-skill.py
AGENT_LOCAL_MCP_ENABLED=false
# 先执行 V34；持久安装队列默认关闭
AGENT_MCP_DURABLE_INSTALL_ENABLED=false
# Requires V47, the updated runner, and its independently preserved execution journal volume.
AGENT_MCP_EXECUTION_RECEIPTS_ENABLED=false
# Linux-only owned Stdio execution; requires V47/V49 and receipts. Windows retains explicit unverified legacy behavior.
AGENT_MCP_NATIVE_PROCESS_ENABLED=false
# Pauses new installs, SDK probes and Fetch calls; reads, cancellation and exit reconciliation remain available.
# Keep false for a compatible recovery baseline before first native protocol activation.
AGENT_MCP_WRITES_ENABLED=true
# Supervisor-only fixed gateway image retirement; requires V59/V60, runner lifecycle 2 and backend protocol 4 recovery baseline.
AGENT_MCP_SHARED_IMAGE_CLEANUP_ENABLED=false
# Linux only; requires native process receipts, durable queue, lifecycle and install reconciliation.
# Apply V58 first. Native installs reserve 512 MiB each; use >= 1 GiB to retain an old version during upgrade.
# The supervisor monitors logical size; this is not an OS hard disk quota.
AGENT_MCP_NATIVE_INSTALL_ENABLED=false
# Requires receipts and durable queue: GATEWAY with V48/V49/V58, or supervised Linux STDIO with V58.
# No migration is applied automatically; native install also requires reconciliation and >= 512 MiB quota.
AGENT_MCP_LIFECYCLE_ENABLED=false
# Requires V49 and lifecycle. Linux captures boot/PID namespace; other OSes need a unique stable host identifier.
AGENT_MCP_INSTALL_RECONCILIATION_ENABLED=false
AGENT_MCP_INSTALL_PROCESS_NODE_ID=
AGENT_MCP_STORAGE_QUOTA_BYTES=268435456
# Comma-separated reviewed immutable image IDs for rollback; never tags or user-supplied images.
MCP_FETCH_APPROVED_IMAGES=
AGENT_LOCAL_MCP_PYTHON=/usr/bin/python3
AGENT_LOCAL_MCP_INSTALLER=/app/script/shell/install-local-fetch-mcp.py
# Optional compose.ai-gateway.yml: provision these server-only values first.
AGENT_MCP_TRANSPORT=STDIO
AGENT_MCP_GATEWAY_SECRET=
AGENT_MCP_GATEWAY_KEY=
MCP_FETCH_IMAGE=
MCP_EGRESS_IMAGE=
MCP_DOCKER_GID=
MCP_SERVER_PUBLIC_IPS=
# Without the overlay the direct provider route remains active.
AGENT_MODEL_GATEWAY_BASE_URL=

# Mem0 容器启动时需要有效的 LLM/Embedding 配置；不随应用镜像打包密钥。
MEM0_ENABLED=true
MEM0_SERVICE_URL=http://mem0:8081
MEM0_BRIDGE_TOKEN=replace-with-random-memory-bridge-token
MEM0_DATA_DIR=/data
# 可选：记忆提炼专用模型，留空沿用 DASHSCOPE_MODEL。
MEM0_LLM_MODEL=
# 模型管理仍默认关闭；启用时合并 compose.model-config.yml，并提供实际提炼模型名称。
AGENT_MODEL_CONFIG_ENABLED=false
# 指向服务器上独立保存的文件，只存路径；文件内容是 32 字节随机值的 Base64。
# 需由 UID 10001 可读，并在数据库/文件卷备份之外单独保管；不要放入发布目录或 Git。
MODEL_CONFIG_MASTER_KEY_SOURCE=
MEM0_PROVIDER_TIMEOUT_SECONDS=15
# 自动记忆提炼独立模型等待上限；不延长 Embedding 等待，不重试未知写操作。
MEM0_EXTRACTION_TIMEOUT_SECONDS=30
MEM0_WRITE_RESPONSE_SECONDS=3
MEM0_WRITE_REVIEW_SECONDS=120
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
CHAT_ASSISTANT_CHROMA_ENABLED=true
CHAT_ASSISTANT_CHROMA_BASE_URL=http://chroma:8000

ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=replace-with-oss-bucket
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
OSS_UPLOAD_HOST=replace-with-oss-bucket.oss-cn-beijing.aliyuncs.com
JAVA_OPTS=-XX:InitialRAMPercentage=15 -XX:MaxRAMPercentage=60 -Djava.awt.headless=true

# 仅清理本人已确认的到期记忆；关闭调度不会取消检索端的停用/到期过滤。
MEM0_LIFECYCLE_CLEANUP_ENABLED=true
MEM0_CLEANUP_INTERVAL_SECONDS=60

# 允许本人主动发起语义记忆审阅；关闭后仍可读取历史、执行已确认的治理。
MEM0_DUPLICATE_REVIEW_ENABLED=true
# 手动语义对比等待上限 1—60 秒，独立于自动提炼的供应商超时。
MEM0_DUPLICATE_REVIEW_TIMEOUT_SECONDS=30

# V40/V52 required; file delivery audit remains independently disabled until acceptance.
OPERATIONS_AUDIT_ENABLED=false
OPERATIONS_FILE_DELIVERY_AUDIT_ENABLED=false
