# 仅模板。真实值由 Jenkins Credentials 注入环境；勿提交、归档或打印 compose config 展开值。
# 必须先资源预检，默认禁用；当前 16GiB 主机不满足全生产门。
LANGFUSE_RESOURCE_MODE=production
LANGFUSE_RESOURCE_APPROVED=
# PG 用户/库固定 langfuse，URL 中口令必须按 URL 编码
LF_POSTGRES_PASSWORD=
LF_DATABASE_URL=
LF_CLICKHOUSE_PASSWORD=
LF_REDIS_PASSWORD=
LF_SALT=
LF_ENCRYPTION_KEY=
LF_NEXTAUTH_SECRET=
LF_NEXTAUTH_URL=http://127.0.0.1:13000
LF_INIT_ORG_ID=doorhandle-observability
LF_INIT_ORG_NAME=Doorhandle Observability
LF_INIT_PROJECT_ID=doorhandle-monolith
LF_INIT_PROJECT_NAME=Doorhandle Monolith
LF_INIT_PROJECT_PUBLIC_KEY=
LF_INIT_PROJECT_SECRET_KEY=
LF_INIT_USER_EMAIL=
LF_INIT_USER_NAME=Operator
LF_INIT_USER_PASSWORD=
# 单独授权现有 OSS bucket 的 langfuse/ 前缀，不允许业务数据全桶权限
LF_S3_BUCKET=
LF_S3_REGION=
LF_S3_ENDPOINT=
LF_S3_ACCESS_KEY_ID=
LF_S3_SECRET_ACCESS_KEY=
LF_S3_FORCE_PATH_STYLE=false
OBSERVABILITY_SECRETS_DIR=
OBSERVABILITY_SECRET_GID=10001
# 实际部署时以同版本已核定 digest 覆盖镜像；不使用 latest
PROMETHEUS_IMAGE=prom/prometheus:v3.16.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.35.0
LANGFUSE_WEB_IMAGE=docker.langfuse.com/langfuse/langfuse:4.79.0
LANGFUSE_WORKER_IMAGE=docker.langfuse.com/langfuse/langfuse-worker:4.79.0
LANGFUSE_POSTGRES_IMAGE=postgres:17.12-alpine3.24
LANGFUSE_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.3.62.3
LANGFUSE_REDIS_IMAGE=redis:7.4.12-alpine3.22
