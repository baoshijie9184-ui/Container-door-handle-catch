  "mappingMeaning": "Primary historical-record destination inventory only. Conditional and multi-target copies are listed in additionalRoutes; the inventory does not prove lossless migration or runtime cutover.",
  "additionalRoutes": [
    {
      "source": "agent_model_budget_attempt",
      "target": "llm_usage",
      "rule": "Import reported input/output components as enterprise ledger lower bounds linked to immutable anonymous audit snapshots. Preserve unknown usage in llm_quota.unreconciled_legacy_attempts; do not invent workflow requests or retroactive personal charges."
    },
    {
      "source": "agent_session_fork",
      "target": "chat_session",
      "rule": "Only the existing owned child session receives its current fork projection. The authoritative permanent receipt is in workflow_instance and survives child deletion."
    },
    {
      "source": "agent_research_source",
      "target": "content_revision",
      "rule": "Keep original full-source digest separately from stored-excerpt digest and purge state."
    },
    {
      "source": "agent_research_source",
      "target": "content_link",
      "rule": "Preserve unique owner/run/call provenance."
    },
    {
      "source": "detection_image_fingerprint",
      "target": "runtime_state",
      "rule": "Preserve the latest per-hash detection projection independently of file identity."
    },
    {
      "source": "agent_model_budget_attempt",
      "target": "llm_quota",
      "rule": "Aggregate enterprise known consumption and unresolved attempt count. Finite accounts with unresolved history refuse new admissions; no fabricated zero usage."
    },
    {
      "source": "agent_memory_audit",
      "target": "workflow_instance",
      "rule": "Only non-PREFERENCE_CHANGED rows become MEMORY_MUTATION workflow snapshots; each also retains an immutable final-state audit snapshot. Preference changes remain audit_event only; no invented intermediate history."
    },
    {
      "source": "agent_context_turn",
      "target": "chat_message",
      "rule": "Populate a live projection and its owned evidence pointer only when an actual authorized message exists. Preserve the independent original evidence, including orphan identities, in audit_event; message/session/user deletion does not remove it and session renaming does not rewrite it."
    },
    {
      "source": "agent_message_execution",
      "target": "chat_message",
      "rule": "Populate a live projection and its owned evidence pointer only when an actual authorized message exists. Preserve the independent original evidence, including orphan identities, in audit_event; message/session/user deletion does not remove it and session renaming does not rewrite it."
    },
    {
      "source": "agent_workspace_turn_snapshot",
      "target": "chat_message",
      "rule": "Populate a live projection and its owned evidence pointer only when an actual authorized message exists. Preserve the independent original evidence, including orphan identities, in audit_event; message/session/user deletion does not remove it and session renaming does not rewrite it."
    },
    {
      "source": "detection_identity_binding",
      "target": "runtime_state",
      "rule": "Keep original task/role binding heads, including orphan tasks or absent evidence, in DETECTION_IDENTITY_BINDING. Never invent a detection task or event; runtime authorization still requires current task and matching immutable identity evidence."
    }
  ],
