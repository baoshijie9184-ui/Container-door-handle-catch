// Local Windows control node; all tests and runtime stay on ECS over SSH.
// ECS start/stop is managed outside CI/CD, with no cloud lifecycle calls here.
def configureVerificationInputs() {
    if (!(params.ACTION in ['verify', 'verify-controls', 'verify-embedding', 'verify-runtime', 'verify-deploy', 'rehearse', 'rollback', 'compact-cutover', 'reclaim-build-outputs'])) error('Unsupported pipeline action')
    if (env.DOORHANDLE_ECS_INSTANCE_ID != 'i-2zeieuov2aum486jm1ek' || !(env.DOORHANDLE_ECS_MACHINE_ID ==~ /[a-f0-9]{32}/)) error('Configure the admitted ECS instance and machine identity on the control node')
    env.DEPLOY_HOST = params.DEPLOY_HOST?.trim() ?: ''
    if (!env.DEPLOY_HOST) {
        currentBuild.result = 'NOT_BUILT'
        currentBuild.description = 'Waiting for externally started ECS and verified connection settings; no tests executed.'
        error('Start ECS outside Jenkins and configure its verified current address first')
    }
    if (!(params.DOORHANDLE_CI_SCOPE in ['source', 'mysql'])) error('Unsupported verification scope')
    env.DOORHANDLE_CI_SCOPE = params.DOORHANDLE_CI_SCOPE
    env.DOORHANDLE_CI_FIXTURE_MANIFEST = params.DOORHANDLE_CI_FIXTURE_MANIFEST?.trim() ?: ''
    env.DOORHANDLE_CI_AUTO_COMPACT_FIXTURES = params.DOORHANDLE_CI_AUTO_COMPACT_FIXTURES ? 'true' : 'false'
    env.DOORHANDLE_CI_FIXTURE_SETTINGS = params.DOORHANDLE_CI_FIXTURE_SETTINGS?.trim() ?: ''
    env.LEGACY_SOURCE_SNAPSHOT = params.LEGACY_SOURCE_SNAPSHOT?.trim() ?: ''
    env.LEGACY_SOURCE_ECS_SNAPSHOT = params.LEGACY_SOURCE_ECS_SNAPSHOT?.trim() ?: ''
    env.LOCAL_ARTIFACTS_SNAPSHOT = params.LOCAL_ARTIFACTS_SNAPSHOT?.trim() ?: ''
    env.LOCAL_ARTIFACTS_ECS_SNAPSHOT = params.LOCAL_ARTIFACTS_ECS_SNAPSHOT?.trim() ?: ''
    env.LOCAL_ARTIFACTS_PROFILE = params.LOCAL_ARTIFACTS_PROFILE ?: 'additional-local-artifacts-v1'
    if (!(env.LOCAL_ARTIFACTS_PROFILE in ['additional-local-artifacts-v1', 'residual-project-originals-v1', 'legacy-partial-transports-v1', 'remaining-business-records-v1'])) error('Unsupported fixed artifact profile')
    env.COLD_STORES_SNAPSHOT = params.COLD_STORES_SNAPSHOT?.trim() ?: ''
    env.COLD_STORES_ECS_SNAPSHOT = params.COLD_STORES_ECS_SNAPSHOT?.trim() ?: ''
    if (!(params.COLD_STORES_PROFILE in ['cold-store-originals-v1', 'cold-store-history-v2'])) error('Unsupported fixed cold-store profile')
    env.COLD_STORES_PROFILE = params.COLD_STORES_PROFILE
    env.COLD_HISTORY_SNAPSHOT = params.COLD_HISTORY_SNAPSHOT?.trim() ?: ''
    env.COLD_HISTORY_ECS_SNAPSHOT = params.COLD_HISTORY_ECS_SNAPSHOT?.trim() ?: ''
    env.LOCAL_MYSQL_SNAPSHOT = params.LOCAL_MYSQL_SNAPSHOT?.trim() ?: ''
    env.LOCAL_MYSQL_ECS_SNAPSHOT = params.LOCAL_MYSQL_ECS_SNAPSHOT?.trim() ?: ''
    env.LOCAL_MYSQL_FIXTURE_SETTINGS = params.LOCAL_MYSQL_FIXTURE_SETTINGS?.trim() ?: ''
    env.PROJECT_MYSQL_SNAPSHOT = params.PROJECT_MYSQL_SNAPSHOT?.trim() ?: ''
    env.PROJECT_MYSQL_MANIFEST_SHA256 = params.PROJECT_MYSQL_MANIFEST_SHA256?.trim() ?: ''
    env.PROJECT_MYSQL_ARCHIVE_SHA256 = params.PROJECT_MYSQL_ARCHIVE_SHA256?.trim() ?: ''
    env.REMAINING_SYSTEM_DATA_SNAPSHOT = params.REMAINING_SYSTEM_DATA_SNAPSHOT?.trim() ?: ''
    env.REMAINING_SYSTEM_DATA_ECS_SNAPSHOT = params.REMAINING_SYSTEM_DATA_ECS_SNAPSHOT?.trim() ?: ''
    env.CANDIDATE_BUILD_TOOLS_ARCHIVE = params.CANDIDATE_BUILD_TOOLS_ARCHIVE?.trim() ?: ''
    if (params.ACTION in ['reclaim-build-outputs', 'verify-controls']) {
        def businessInputs = [env.LEGACY_SOURCE_SNAPSHOT, env.LEGACY_SOURCE_ECS_SNAPSHOT,
            env.LOCAL_ARTIFACTS_SNAPSHOT, env.LOCAL_ARTIFACTS_ECS_SNAPSHOT,
            env.COLD_STORES_SNAPSHOT, env.COLD_STORES_ECS_SNAPSHOT,
            env.COLD_HISTORY_SNAPSHOT, env.COLD_HISTORY_ECS_SNAPSHOT,
            env.LOCAL_MYSQL_SNAPSHOT, env.LOCAL_MYSQL_ECS_SNAPSHOT, env.LOCAL_MYSQL_FIXTURE_SETTINGS,
            env.PROJECT_MYSQL_SNAPSHOT, env.PROJECT_MYSQL_MANIFEST_SHA256, env.PROJECT_MYSQL_ARCHIVE_SHA256,
            env.REMAINING_SYSTEM_DATA_SNAPSHOT, env.REMAINING_SYSTEM_DATA_ECS_SNAPSHOT]
        def releaseInputs = [params.COMPACT_CUTOVER_SETTINGS?.trim(), params.COMPATIBLE_BACKEND_IMAGE?.trim(),
            params.COMPATIBLE_RUNNER_IMAGE?.trim(), params.REHEARSAL_MEMORY_EXTRACTION_MODEL?.trim()]
        if (params.DOORHANDLE_CI_SCOPE != 'source' || businessInputs.any { it } || releaseInputs.any { it }
            || env.DOORHANDLE_CI_FIXTURE_MANIFEST || env.DOORHANDLE_CI_FIXTURE_SETTINGS || params.DOORHANDLE_CI_AUTO_COMPACT_FIXTURES
            || env.CANDIDATE_BUILD_TOOLS_ARCHIVE || params.PRODUCTION_RELEASE_ENABLED || params.REHEARSAL_KEEP
            || env.LOCAL_ARTIFACTS_PROFILE != 'additional-local-artifacts-v1' || env.COLD_STORES_PROFILE != 'cold-store-originals-v1'
            || env.DOORHANDLE_COMPACT_RELEASE_READY == 'true' || env.DOORHANDLE_COMPACT_REHEARSAL_READY == 'true') {
            error('Independent control verification or build maintenance accepts only fixed source and ECS connection inputs; business, fixture, model and release inputs are forbidden')
        }
        env.CI_ECS_VERIFIED = 'false'
        currentBuild.description = params.ACTION == 'verify-controls'
            ? 'Control verification only: pinned source and ECS control-script tests; no Java build, databases or business verification.'
            : 'Maintenance only: pinned source and proven old build outputs; no project tests or application runtime.'
    }
    if (env.CANDIDATE_BUILD_TOOLS_ARCHIVE && !(params.ACTION in ['verify-runtime', 'compact-cutover'])) error('Candidate build inputs are only accepted by runtime verification or compact cutover')
    if (env.LEGACY_SOURCE_SNAPSHOT && env.LEGACY_SOURCE_ECS_SNAPSHOT) error('Choose exactly one local or ECS legacy snapshot input')
    if (env.LOCAL_ARTIFACTS_SNAPSHOT && env.LOCAL_ARTIFACTS_ECS_SNAPSHOT) error('Choose exactly one local or ECS additional artifact snapshot input')
    if (env.COLD_STORES_SNAPSHOT && env.COLD_STORES_ECS_SNAPSHOT) error('Choose exactly one local or ECS historical cold-store snapshot input')
    if (env.COLD_HISTORY_SNAPSHOT && env.COLD_HISTORY_ECS_SNAPSHOT) error('Choose exactly one local or ECS additional historical test-store input')
    if ((env.COLD_HISTORY_SNAPSHOT || env.COLD_HISTORY_ECS_SNAPSHOT) && env.COLD_STORES_PROFILE == 'cold-store-history-v2' && (env.COLD_STORES_SNAPSHOT || env.COLD_STORES_ECS_SNAPSHOT)) error('The same fixed history profile cannot be preserved twice in one build')
    if (env.LOCAL_MYSQL_SNAPSHOT && env.LOCAL_MYSQL_ECS_SNAPSHOT) error('Choose exactly one local or ECS MySQL export snapshot input')
    if (env.REMAINING_SYSTEM_DATA_SNAPSHOT && env.REMAINING_SYSTEM_DATA_ECS_SNAPSHOT) error('Choose exactly one local or ECS remaining system data snapshot input')
    if (params.ACTION == 'verify-embedding' && (env.REMAINING_SYSTEM_DATA_SNAPSHOT || env.REMAINING_SYSTEM_DATA_ECS_SNAPSHOT)) error('Embedding verification cannot preserve remaining business data')
    def projectSqlInputs = [env.PROJECT_MYSQL_SNAPSHOT, env.PROJECT_MYSQL_MANIFEST_SHA256, env.PROJECT_MYSQL_ARCHIVE_SHA256]
    if (projectSqlInputs.any { it } && !projectSqlInputs.every { it }) error('Project MySQL custody requires all three explicit packet inputs or all blank')
    if (env.PROJECT_MYSQL_SNAPSHOT && (!(params.ACTION in ['verify', 'verify-runtime']) || params.DOORHANDLE_CI_SCOPE != 'mysql' || params.PRODUCTION_RELEASE_ENABLED)) error('Project MySQL custody only archives and recovers in complete MySQL verification; production and maintenance actions are forbidden')
    if (env.PROJECT_MYSQL_SNAPSHOT && (!(env.PROJECT_MYSQL_MANIFEST_SHA256 ==~ /[a-f0-9]{64}/) || !(env.PROJECT_MYSQL_ARCHIVE_SHA256 ==~ /[a-f0-9]{64}/))) error('Project MySQL custody requires explicit fixed manifest and archive SHA-256')
    def anySqlCustody = env.LOCAL_MYSQL_SNAPSHOT || env.LOCAL_MYSQL_ECS_SNAPSHOT || env.PROJECT_MYSQL_SNAPSHOT
    if ((anySqlCustody && !env.LOCAL_MYSQL_FIXTURE_SETTINGS) || (!anySqlCustody && env.LOCAL_MYSQL_FIXTURE_SETTINGS)) error('MySQL custody requires a sealed export packet and the shared reviewed private ECS image settings')
    if (params.ACTION == 'verify-embedding' && (params.DOORHANDLE_CI_SCOPE != 'source' || params.DOORHANDLE_CI_AUTO_COMPACT_FIXTURES || env.LEGACY_SOURCE_SNAPSHOT || env.LEGACY_SOURCE_ECS_SNAPSHOT || env.LOCAL_ARTIFACTS_SNAPSHOT || env.LOCAL_ARTIFACTS_ECS_SNAPSHOT || env.LOCAL_ARTIFACTS_PROFILE != 'additional-local-artifacts-v1' || env.COLD_STORES_SNAPSHOT || env.COLD_STORES_ECS_SNAPSHOT || env.COLD_HISTORY_SNAPSHOT || env.COLD_HISTORY_ECS_SNAPSHOT || env.LOCAL_MYSQL_SNAPSHOT || env.LOCAL_MYSQL_ECS_SNAPSHOT || env.LOCAL_MYSQL_FIXTURE_SETTINGS || params.PRODUCTION_RELEASE_ENABLED)) error('Embedding verification is an independent source component check without legacy migration or production release')
    if (params.DOORHANDLE_CI_SCOPE == 'source' && env.DOORHANDLE_CI_FIXTURE_MANIFEST) error('Source verification cannot accept a MySQL fixture manifest')
    if (params.DOORHANDLE_CI_AUTO_COMPACT_FIXTURES) {
        if (params.DOORHANDLE_CI_SCOPE != 'mysql' || env.DOORHANDLE_CI_FIXTURE_MANIFEST || !env.DOORHANDLE_CI_FIXTURE_SETTINGS) error('Automatic compact fixtures require mysql scope, private ECS settings and no conflicting manual manifest')
    } else if (params.DOORHANDLE_CI_SCOPE == 'mysql' && !env.DOORHANDLE_CI_FIXTURE_MANIFEST) error('MySQL verification requires a pre-provisioned private ECS fixture manifest')
    if (params.ACTION in ['verify-deploy', 'rollback', 'compact-cutover']) {
        if (!params.PRODUCTION_RELEASE_ENABLED || env.DOORHANDLE_COMPACT_RELEASE_READY != 'true') error('Production publish/rollback remains disabled until compact database acceptance is complete')
    }
    if (params.ACTION == 'compact-cutover') {
        def selectedSettings = params.COMPACT_CUTOVER_SETTINGS?.trim() ?: env.DOORHANDLE_CI_FIXTURE_SETTINGS
        if (params.DOORHANDLE_CI_SCOPE != 'mysql' || !selectedSettings) error('First cutover requires complete MySQL acceptance and explicit reviewed private ECS settings')
        if ((!env.LOCAL_MYSQL_SNAPSHOT && !env.LOCAL_MYSQL_ECS_SNAPSHOT) || !env.LOCAL_MYSQL_FIXTURE_SETTINGS) error('First cutover requires the approved legacy MySQL export and independent recovery/source-inclusion audit; its stage cannot be skipped')
        if (env.DOORHANDLE_CI_FIXTURE_SETTINGS && selectedSettings != env.DOORHANDLE_CI_FIXTURE_SETTINGS) error('Fixture and cutover must use the same reviewed source settings')
        env.COMPACT_CUTOVER_SETTINGS = selectedSettings
    }
    if (params.ACTION == 'verify-runtime' && (params.DOORHANDLE_CI_SCOPE != 'mysql' || !env.DOORHANDLE_CI_FIXTURE_SETTINGS)) error('Runtime acceptance requires complete MySQL scope and the private ECS fixture settings')
    if (params.ACTION in ['verify-runtime', 'compact-cutover'] && !env.LEGACY_SOURCE_SNAPSHOT && !env.LEGACY_SOURCE_ECS_SNAPSHOT) error('Complete runtime acceptance requires the sealed legacy source snapshot for preservation and independent recovery')
    if (params.ACTION in ['verify-runtime', 'compact-cutover'] && env.LOCAL_ARTIFACTS_PROFILE != 'additional-local-artifacts-v1') error('Complete runtime acceptance uses the original model and upload artifact profile')
    if (params.ACTION == 'rehearse' && env.DOORHANDLE_COMPACT_REHEARSAL_READY != 'true') error('Legacy rehearsal remains disabled until its compact database adapter is accepted')
}

pipeline {
    agent {
        node {
            label 'doorhandle-local-ci'
            customWorkspace 'D:/AI/lunwen1/DoorHandleCatch/work/jenkins/ci-workspaces/monolith'
        }
    }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        disableRestartFromStage()
        timestamps()
        timeout(time: 240, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15', artifactNumToKeepStr: '5'))
    }
    triggers { pollSCM('H/5 * * * *') }
    parameters {
        choice(name: 'ACTION', choices: ['verify', 'verify-controls', 'verify-embedding', 'verify-runtime', 'verify-deploy', 'rehearse', 'rollback', 'compact-cutover', 'reclaim-build-outputs'], description: 'verify-controls仅运行ECS控制脚本预检；verify-embedding独立验证免费向量模型；verify-runtime验收隔离应用；reclaim-build-outputs仅维护旧构建输出；切库仍须完整证据')
        string(name: 'TRUSTED_COMMIT', defaultValue: '', trim: true, description: '可选 java-cloud 完整提交；留空时固定本次 SCM 检出的提交')
        choice(name: 'DOORHANDLE_CI_SCOPE', choices: ['source', 'mysql'], description: 'source 记录可选套件跳过；mysql 要求显式隔离夹具及所有选择用例实际执行')
        string(name: 'DOORHANDLE_CI_FIXTURE_MANIFEST', defaultValue: '', trim: true, description: '仅 mysql：本次远端 checkout/work 内预先准备的绝对私有清单路径；source 必须留空')
        booleanParam(name: 'DOORHANDLE_CI_AUTO_COMPACT_FIXTURES', defaultValue: false, description: 'mysql：用本次固定提交制品，在 ECS 自动准备独立数据库和完整验收清单')
        string(name: 'DOORHANDLE_CI_FIXTURE_SETTINGS', defaultValue: '', trim: true, description: '自动夹具：ECS 现有私有 JSON 路径，仅指定原库身份、已核对时区和既有 Java')
        booleanParam(name: 'PRODUCTION_RELEASE_ENABLED', defaultValue: false, description: '发布/回滚开关；机器环境 DOORHANDLE_COMPACT_RELEASE_READY 仍须为 true')
        string(name: 'COMPACT_CUTOVER_SETTINGS', defaultValue: '', trim: true, description: '可复用夹具设置：ECS私有JSON，version/sourceMysqlContainerId/sourceSchema/sourceOffsets/java，不含密码')
        string(name: 'CANDIDATE_BUILD_TOOLS_ARCHIVE', defaultValue: '', trim: true, description: '运行验收/首次切换的公开BuildKit OCI包；空值自动准备固定D盘缓存，不归档原tar')
        string(name: 'LEGACY_SOURCE_SNAPSHOT', defaultValue: '', trim: true, description: '可选本地原始数据字节封存目录；源码验证通过后上传ECS并逐文件恢复核对，不在本地打开数据库')
        string(name: 'LEGACY_SOURCE_ECS_SNAPSHOT', defaultValue: '', trim: true, description: '后续复用ECS已恢复核验的旧数据封存目录；与本地输入互斥，业务原件不回传本地')
        string(name: 'LOCAL_ARTIFACTS_SNAPSHOT', defaultValue: '', trim: true, description: '首次上传额外历史模型、备份、日志与上传文件的私有字节封存目录')
        string(name: 'LOCAL_ARTIFACTS_ECS_SNAPSHOT', defaultValue: '', trim: true, description: '后续复用ECS已恢复核验的额外原件；与对应本地输入互斥')
        choice(name: 'LOCAL_ARTIFACTS_PROFILE', choices: ['additional-local-artifacts-v1', 'residual-project-originals-v1', 'legacy-partial-transports-v1', 'remaining-business-records-v1'], description: '固定原件清单：原36项、项目残留文件、早期运输包或250项业务记录与历史回执')
        string(name: 'COLD_STORES_SNAPSHOT', defaultValue: '', trim: true, description: '可选历史测试存储冷归档私有目录；完整验证后在ECS逐存储树独立恢复核验')
        string(name: 'COLD_STORES_ECS_SNAPSHOT', defaultValue: '', trim: true, description: '复用ECS已核验的历史测试存储冷归档；与对应本地输入互斥')
        choice(name: 'COLD_STORES_PROFILE', choices: ['cold-store-originals-v1', 'cold-store-history-v2'], description: '固定冷归档清单；v1为原70存储根，v2为额外4041历史测试与工具回执根')
        string(name: 'COLD_HISTORY_SNAPSHOT', defaultValue: '', trim: true, description: '同次验证额外保全4041个历史测试和工具回执目录的固定v2字节包')
        string(name: 'COLD_HISTORY_ECS_SNAPSHOT', defaultValue: '', trim: true, description: '同次验证复用ECS上已核验的v2历史目录包；与对应本地输入互斥')
        string(name: 'LOCAL_MYSQL_SNAPSHOT', defaultValue: '', trim: true, description: '已授权本机45表只读导出包；源码验证后在ECS独立双恢复核验，不合入生产')
        string(name: 'LOCAL_MYSQL_ECS_SNAPSHOT', defaultValue: '', trim: true, description: '复用ECS已核验的45表导出封存目录；与本地输入互斥，在本轮重新独立双恢复')
        string(name: 'LOCAL_MYSQL_FIXTURE_SETTINGS', defaultValue: '', trim: true, description: '旧45表或新三库恢复共用的现有ECS私有夹具JSON；仅读取已核对的MySQL镜像身份')
        string(name: 'PROJECT_MYSQL_SNAPSHOT', defaultValue: '', trim: true, description: '可选已批准三库v2封存包；只在完整MySQL验证后于ECS双恢复归档')
        string(name: 'PROJECT_MYSQL_MANIFEST_SHA256', defaultValue: '', trim: true, description: '上述三库custody.json的明确固定SHA-256；三项同时填写或全空')
        string(name: 'PROJECT_MYSQL_ARCHIVE_SHA256', defaultValue: '', trim: true, description: '上述三库originals.tar.gz的明确固定SHA-256；不合入生产或授权本地删除')
        string(name: 'REMAINING_SYSTEM_DATA_SNAPSHOT', defaultValue: '', trim: true, description: '补充86项本地系统数据的固定私有封存目录；完整验证后在ECS独立恢复，不自动合入业务')
        string(name: 'REMAINING_SYSTEM_DATA_ECS_SNAPSHOT', defaultValue: '', trim: true, description: '复用已核验的补充系统数据ECS封存目录；与本地输入互斥')
        booleanParam(name: 'RECLAIM_OLD_BUILD_OUTPUTS', defaultValue: true, description: '本构建完整验证通过后，按原始证据与精确计划清理旧构建可再生输出，保留业务数据和报告')
        string(name: 'DEPLOY_HOST', defaultValue: "${params.DEPLOY_HOST ?: ''}", trim: true, description: '流水线外启动 ECS 后核对的当前地址；首次为空，不自动开机')
        string(name: 'DEPLOY_PORT', defaultValue: "${params.DEPLOY_PORT ?: '22'}", trim: true, description: '已核验的 SSH 端口；TLS 通道可显式使用 443')
        choice(name: 'SSH_TRANSPORT', choices: params.SSH_TRANSPORT == 'tls' ? ['tls', 'direct'] : ['direct', 'tls'], description: 'direct 校验 SSH 主机公钥；tls 额外校验证书')
        string(name: 'SSH_TLS_CA_FILE', defaultValue: 'D:/AI/lunwen1/DoorHandleCatch/work/cloud/ssh-tls/server.crt', description: '已有且经可信渠道核对的服务器公有证书')
        string(name: 'OPENSSL_EXE', defaultValue: 'D:/ruanjian/Git/usr/bin/openssl.exe', description: '已有 Git OpenSSL 客户端')
        string(name: 'REMOTE_ROOT', defaultValue: '/home/ecs-user/doorhandle-ci', description: '独立验证目录、制品及发布状态根目录')
        string(name: 'REMOTE_RUNTIME', defaultValue: '/home/ecs-user/doorhandle-release-20261014', description: '现有部署目录；不作为测试 checkout 使用')
        string(name: 'PYTHON_EXE', defaultValue: 'D:/ruanjian/anaconda3/envs/leetcode/python.exe', description: '本地控制脚本使用的已有 Python，不在本地运行 pytest')
        choice(name: 'BUILD_NPM_REGISTRY', choices: ['https://registry.npmjs.org', 'https://registry.npmmirror.com'], description: '仅本次远端构建使用，不修改生产环境或锁文件')
        booleanParam(name: 'REHEARSAL_KEEP', defaultValue: false, description: '仅已验收的隔离演练可保留候选环境供查看')
        string(name: 'COMPATIBLE_BACKEND_IMAGE', defaultValue: '', trim: true, description: '可选已独立验收的兼容旧版后端 sha256 镜像')
        string(name: 'COMPATIBLE_RUNNER_IMAGE', defaultValue: '', trim: true, description: '可选已独立验收的兼容旧版 MCP runner sha256 镜像')
        string(name: 'REHEARSAL_MEMORY_EXTRACTION_MODEL', defaultValue: '', trim: true, description: '可选明确指定的隔离演练提炼模型，不更改生产配置')
    }
    stages {
        stage('Trusted checkout') {
            steps {
                script {
                    env.CI_ECS_VERIFIED = 'false'
                    env.CI_CONTROL_PREFLIGHT_PASS = 'false'
                    env.CI_ARTIFACTS_READY = 'false'
                    env.CI_FIXTURES_PREPARED = 'false'
                    env.CI_TOOLS_PREPARED = 'false'
                    env.CI_TOOLS_ATTEMPTED = 'false'
                    env.CI_FIXTURE_PREPARATION_ATTEMPTED = 'false'
                    env.CI_RUNTIME_ATTEMPTED = 'false'
                    env.CI_RUNTIME_VERIFIED = 'false'
                    env.CI_LEGACY_CANDIDATE_ATTEMPTED = 'false'
                    env.CI_LEGACY_CANDIDATE_PREPARED = 'false'
                    env.CI_LOCAL_MYSQL_ATTEMPTED = 'false'
                    env.CI_PROJECT_MYSQL_ATTEMPTED = 'false'
                    if (isUnix()) error('Control steps require the dedicated local Windows agent')
                    def expectedWorkspace = 'D:/AI/lunwen1/DoorHandleCatch/work/jenkins/ci-workspaces/monolith'
                    if (pwd().replace('\\', '/') != expectedWorkspace) error('Unexpected CI workspace')
                    dir('artifacts') {
                        if (pwd().replace('\\', '/') != "${expectedWorkspace}/artifacts") error('Artifact cleanup escaped the CI workspace')
                        deleteDir()
                    }
                    env.CI_ARTIFACTS_READY = 'true'
                    def revision = checkout scm
                    def branch = (env.BRANCH_NAME ?: revision.GIT_BRANCH ?: '').replaceFirst(/^origin\//, '')
                    def commit = revision.GIT_COMMIT ?: ''
                    if (branch != 'java-cloud' || !(commit ==~ /[a-f0-9]{40}/)) error('SCM must supply an exact java-cloud commit')
                    def requestedCommit = params.TRUSTED_COMMIT?.trim() ?: ''
                    if (requestedCommit && (!(requestedCommit ==~ /[a-f0-9]{40}/) || requestedCommit != commit)) error('SCM commit differs from TRUSTED_COMMIT')
                    env.GIT_BRANCH = branch
                    env.GIT_COMMIT = commit
                    env.RELEASE_TAG = "ci-${env.BUILD_NUMBER}-${commit.take(12)}"
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${commit.take(12)} ${params.ACTION}"
                }
            }
        }
        stage('Configuration gate') {
            steps {
                script {
                    configureVerificationInputs()
                }
            }
        }
        stage('Build locally without tests') {
            when { expression { !(params.ACTION in ['rollback', 'reclaim-build-outputs', 'verify-controls']) } }
            steps { pwsh '& ./script/jenkins/build-local.ps1' }
        }
        stage('Package pinned source') {
            when { expression { params.ACTION != 'rollback' } }
            steps {
                script {
                    if (params.ACTION == 'reclaim-build-outputs') {
                        pwsh '& ./script/jenkins/pipeline.ps1 -Action PackageSourceOnly'
                    } else if (params.ACTION == 'verify-controls') {
                        pwsh '& ./script/jenkins/pipeline.ps1 -Action PackageControls'
                    } else {
                        pwsh '& ./script/jenkins/pipeline.ps1 -Action Package'
                    }
                }
            }
        }
        stage('Maintain proven old build outputs') {
            when { expression { params.ACTION == 'reclaim-build-outputs' } }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action ReclaimBuildOutputs'
                }
            }
        }
        stage('Prepare temporary ECS tools') {
            when { expression { !(params.ACTION in ['rollback', 'reclaim-build-outputs']) } }
            steps {
                script { env.CI_TOOLS_ATTEMPTED = 'true' }
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action PrepareTools'
                }
                script { env.CI_TOOLS_PREPARED = 'true' }
            }
        }
        stage('Preflight control scripts on ECS') {
            when { expression { params.ACTION == 'verify-controls' || (params.ACTION in ['verify', 'verify-runtime'] && params.DOORHANDLE_CI_SCOPE == 'mysql') } }
            steps {
                script { env.CI_CONTROL_PREFLIGHT_PASS = 'false' }
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action Preflight'
                }
                script { env.CI_CONTROL_PREFLIGHT_PASS = 'true' }
            }
        }
        stage('Prepare isolated ECS fixtures') {
            when { expression { !(params.ACTION in ['rollback', 'reclaim-build-outputs', 'verify-controls']) && params.DOORHANDLE_CI_AUTO_COMPACT_FIXTURES } }
            steps {
                script { env.CI_FIXTURE_PREPARATION_ATTEMPTED = 'true' }
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action PrepareFixtures'
                }
                script {
                    env.CI_FIXTURES_PREPARED = 'true'
                    env.DOORHANDLE_CI_FIXTURE_MANIFEST = "${params.REMOTE_ROOT}/verification/${env.RELEASE_TAG}/checkout/work/compact-fixtures/manifest.json"
                }
            }
        }
        stage('Verify free embedding component on ECS') {
            when { expression { params.ACTION == 'verify-embedding' } }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS'),
                    string(credentialsId: 'doorhandle-siliconflow-embedding', variable: 'SILICONFLOW_EMBEDDING_API_KEY')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action VerifyEmbedding'
                }
            }
        }
        stage('Verify on ECS over SSH') {
            when { expression { !(params.ACTION in ['rollback', 'verify-controls', 'verify-embedding', 'reclaim-build-outputs']) } }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '''
                        $ErrorActionPreference = 'Stop'
                        & ./script/jenkins/pipeline.ps1 -Action VerifyEcs
                        $reports = @(Get-ChildItem -LiteralPath artifacts/ecs -Recurse -File -Filter 'TEST-*.xml' -ErrorAction Stop)
                        if ($reports.Count -eq 0) { throw 'ECS verification returned without Java test reports; publishing is blocked.' }
                    '''
                }
                script { env.CI_ECS_VERIFIED = 'true' }
            }
        }
        stage('Repair registered prior CI evidence permissions') {
            when { expression { !(params.ACTION in ['reclaim-build-outputs', 'verify-controls']) && env.CI_ECS_VERIFIED == 'true' && (env.LEGACY_SOURCE_ECS_SNAPSHOT || (env.LOCAL_ARTIFACTS_PROFILE == 'additional-local-artifacts-v1' && env.LOCAL_ARTIFACTS_ECS_SNAPSHOT)) } }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action RepairPriorEvidence'
                }
            }
        }
        stage('Reclaim proven old build outputs') {
            when { expression { !(params.ACTION in ['reclaim-build-outputs', 'verify-controls']) && params.RECLAIM_OLD_BUILD_OUTPUTS && env.CI_ECS_VERIFIED == 'true' } }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action ReclaimBuildOutputs'
                }
            }
        }
        stage('Preserve legacy source bytes on ECS') {
            when { expression { !(params.ACTION in ['rollback', 'reclaim-build-outputs', 'verify-controls']) && (env.LEGACY_SOURCE_SNAPSHOT || env.LEGACY_SOURCE_ECS_SNAPSHOT) } }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action PreserveLegacy'
                }
            }
        }
        stage('Preserve additional business artifacts on ECS') {
            when { expression { !(params.ACTION in ['rollback', 'reclaim-build-outputs', 'verify-controls']) && (env.LOCAL_ARTIFACTS_SNAPSHOT || env.LOCAL_ARTIFACTS_ECS_SNAPSHOT) } }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action PreserveLocalArtifacts'
                }
            }
        }
        stage('Preserve historical cold stores on ECS') {
            when { expression { !(params.ACTION in ['rollback', 'reclaim-build-outputs', 'verify-controls']) && (env.COLD_STORES_SNAPSHOT || env.COLD_STORES_ECS_SNAPSHOT) } }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action PreserveColdStores'
                }
            }
        }
        stage('Preserve additional historical test stores on ECS') {
            when { expression { !(params.ACTION in ['rollback', 'reclaim-build-outputs', 'verify-controls']) && (env.COLD_HISTORY_SNAPSHOT || env.COLD_HISTORY_ECS_SNAPSHOT) } }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    withEnv(["COLD_STORES_PROFILE=cold-store-history-v2", "COLD_STORES_SNAPSHOT=${env.COLD_HISTORY_SNAPSHOT}", "COLD_STORES_ECS_SNAPSHOT=${env.COLD_HISTORY_ECS_SNAPSHOT}"]) {
                        pwsh '& ./script/jenkins/pipeline.ps1 -Action PreserveColdStores'
                    }
                }
            }
        }
        stage('Recover approved local MySQL export on ECS') {
            when { expression { !(params.ACTION in ['rollback', 'reclaim-build-outputs', 'verify-controls']) && (env.LOCAL_MYSQL_SNAPSHOT || env.LOCAL_MYSQL_ECS_SNAPSHOT) } }
            steps {
                script { env.CI_LOCAL_MYSQL_ATTEMPTED = 'true' }
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action PreserveLocalMySql'
                }
            }
        }
        stage('Preserve remaining system data on ECS') {
            when { expression { !(params.ACTION in ['rollback', 'reclaim-build-outputs', 'verify-controls', 'verify-embedding']) && (env.REMAINING_SYSTEM_DATA_SNAPSHOT || env.REMAINING_SYSTEM_DATA_ECS_SNAPSHOT) } }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action PreserveRemainingArtifacts'
                }
            }
        }
        stage('Recover approved three-schema MySQL packet on ECS') {
            when { expression { params.ACTION in ['verify', 'verify-runtime'] && env.PROJECT_MYSQL_SNAPSHOT } }
            steps {
                script { env.CI_PROJECT_MYSQL_ATTEMPTED = 'true' }
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action PreserveProjectMySql'
                }
            }
        }
        stage('Prepare preserved legacy data candidate on ECS') {
            when { expression { params.ACTION in ['verify-runtime', 'compact-cutover'] } }
            steps {
                script { env.CI_LEGACY_CANDIDATE_ATTEMPTED = 'true' }
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action PrepareLegacyCandidate'
                }
                script { env.CI_LEGACY_CANDIDATE_PREPARED = 'true' }
            }
        }
        stage('Rehearse application') {
            when { expression { params.ACTION == 'rehearse' } }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action Rehearse'
                }
            }
        }
        stage('Accept candidate application on ECS') {
            when { expression { params.ACTION == 'verify-runtime' } }
            steps {
                script { env.CI_RUNTIME_ATTEMPTED = 'true' }
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action VerifyRuntime'
                }
                script { env.CI_RUNTIME_VERIFIED = 'true' }
            }
        }
        stage('Deploy or rollback') {
            when { expression { params.ACTION in ['verify-deploy', 'rollback'] } }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action Publish'
                }
            }
        }
        stage('First compact migration and cutover') {
            when { expression { params.ACTION == 'compact-cutover' } }
            steps {
                script { env.CI_RUNTIME_ATTEMPTED = 'true' }
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                    file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                ]) {
                    pwsh '& ./script/jenkins/pipeline.ps1 -Action CompactCutover'
                }
                script { env.CI_RUNTIME_VERIFIED = 'true' }
            }
        }
    }
    post {
        always {
            script {
                if (params.ACTION == 'reclaim-build-outputs') {
                    if (env.CI_ARTIFACTS_READY == 'true') {
                        archiveArtifacts artifacts: 'artifacts/source.tar.gz,artifacts/release.json,artifacts/build-cleanup-plan.json,artifacts/build-cleanup-receipt.json,artifacts/build-cleanup-result.json,artifacts/native-jar-duplicate-*.json,artifacts/native-jar-duplicate-*.jsonl,artifacts/native-builder-retirement-*.json,artifacts/native-builder-retirement-*.jsonl,artifacts/native-public-layer-duplicate-*.json,artifacts/native-public-layer-duplicate-*.jsonl,artifacts/native-generated-public-image-archive-*.json,artifacts/native-generated-public-image-archive-*.jsonl,artifacts/native-python-build-cache-*.json,artifacts/native-python-build-cache-*.jsonl,artifacts/native-python-build-cache-inspect/*.json', allowEmptyArchive: currentBuild.currentResult != 'SUCCESS', fingerprint: true
                    }
                } else {
                    // A cutover can fail after runtime acceptance and its owned
                    // cleanup have passed. Preserve that completed evidence.
                    if (env.CI_RUNTIME_ATTEMPTED == 'true' && env.CI_RUNTIME_VERIFIED != 'true' && !fileExists('artifacts/runtime-gate-passed.json')) {
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            withCredentials([
                                sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                                file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                            ]) {
                                pwsh '& ./script/jenkins/pipeline.ps1 -Action CleanupRuntime'
                            }
                        }
                    }
                    if (env.CI_LEGACY_CANDIDATE_ATTEMPTED == 'true') {
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            withCredentials([
                                sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                                file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                            ]) {
                                pwsh '& ./script/jenkins/pipeline.ps1 -Action CleanupLegacyCandidate'
                            }
                        }
                    }
                    if (env.CI_PROJECT_MYSQL_ATTEMPTED == 'true') {
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            withCredentials([
                                sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                                file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                            ]) {
                                pwsh '& ./script/jenkins/pipeline.ps1 -Action CleanupProjectMySql'
                            }
                        }
                    }
                    if (env.CI_LOCAL_MYSQL_ATTEMPTED == 'true') {
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            withCredentials([
                                sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                                file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                            ]) {
                                pwsh '& ./script/jenkins/pipeline.ps1 -Action CleanupLocalMySql'
                            }
                        }
                    }
                    if (env.CI_FIXTURE_PREPARATION_ATTEMPTED == 'true') {
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            withCredentials([
                                sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                                file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                            ]) {
                                pwsh '& ./script/jenkins/pipeline.ps1 -Action CleanupFixtures'
                            }
                        }
                    }
                    if (env.CI_TOOLS_PREPARED == 'true') {
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            withCredentials([
                                sshUserPrivateKey(credentialsId: 'doorhandle-ecs-ssh', keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
                                file(credentialsId: 'doorhandle-ecs-known-hosts', variable: 'DEPLOY_KNOWN_HOSTS')
                            ]) {
                                pwsh '& ./script/jenkins/pipeline.ps1 -Action CleanupTools'
                            }
                        }
                    }
                    if (env.CI_ARTIFACTS_READY == 'true') {
                        try {
                            junit testResults: 'artifacts/ecs/**/TEST-*.xml,artifacts/ecs/**/python.xml,artifacts/embedding/python.xml,artifacts/control-preflight/python.xml', allowEmptyResults: env.CI_ECS_VERIFIED != 'true'
                        } finally {
                            archiveArtifacts artifacts: 'artifacts/**/*.json,artifacts/**/*.xml,artifacts/**/*.log,artifacts/runtime-browser/**/*.png,artifacts/ecs/verification-evidence.tar.gz,artifacts/native-jar-duplicate-*.jsonl,artifacts/native-builder-retirement-*.jsonl,artifacts/native-public-layer-duplicate-*.jsonl,artifacts/native-generated-public-image-archive-*.jsonl,artifacts/runtime-resources/resource-probes.jsonl,artifacts/candidate-build-resources/resource-probes.jsonl,artifacts/fixture-build-resources/*/resource-probes.jsonl,artifacts/application.jar,artifacts/source.tar.gz', allowEmptyArchive: currentBuild.currentResult != 'SUCCESS', fingerprint: true
                        }
                    }
                }
            }
            echo 'Jenkins remains running. ECS start/stop is managed outside CI/CD.'
        }
    }
}
