# ============================================================
# DoorHandleCatch 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================================================

# -------------------- 数据库 --------------------
DB_URL="jdbc:mysql://localhost:3306/doorhandledb?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8&rewriteBatchedStatements=true"
DB_USERNAME=root
DB_PASSWORD=your_db_password

# -------------------- Redis（缓存、会话及 Agent 记忆） --------------------
# 本地开发默认连接 localhost:6379；生产环境请改为内网地址并填写密码。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2s
REDIS_CONNECT_TIMEOUT=2s
REDIS_POOL_MAX_ACTIVE=16
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=2
REDIS_POOL_MAX_WAIT=2s
SPRING_CACHE_TYPE=redis
REDIS_HEALTH_ENABLED=true
APP_REDIS_ENABLED=true
APP_REDIS_KEY_PREFIX=doorhandlecatch
APP_REDIS_DEFAULT_TTL=30m
APP_REDIS_TTL_DASHBOARD=5m
APP_REDIS_TTL_MODEL=10m
APP_REDIS_TTL_DEVICE=5m
APP_REDIS_TTL_EMPLOYEE=10m
APP_REDIS_TTL_DETECTION_TASK=2m
APP_REDIS_TTL_CHAT_SESSION=15m

# -------------------- JWT --------------------
JWT_SECRET=your_jwt_secret_key_at_least_256_bits
JWT_EXPIRATION=604800

# -------------------- 阿里云 OSS (Java / Python 共用) --------------------
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=handlecatchs
ALIYUN_OSS_ACCESS_KEY_ID=your_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_access_key_secret

# -------------------- Kafka --------------------
# Java 端
APP_KAFKA_ENABLED=true
APP_KAFKA_BOOTSTRAP_SERVERS=10.20.144.118:9092
APP_KAFKA_CONSUMER_GROUP=doorhandlecatch-detection
APP_KAFKA_TOPIC_TASK_CREATED=detection.task.created
APP_KAFKA_TOPIC_TASK_FINISHED=detection.task.finished
APP_KAFKA_TOPIC_TASK_PROGRESS=detection.task.progress
# Python 端 (独立 worker 使用)
KAFKA_BOOTSTRAP_SERVERS=10.20.144.118:9092
KAFKA_TASK_CREATED_TOPIC=detection.task.created
KAFKA_TASK_FINISHED_TOPIC=detection.task.finished
KAFKA_CONSUMER_GROUP=doorhandlecatch-python
KAFKA_DELIVERY_TIMEOUT_SECONDS=10

# -------------------- Detection Worker --------------------
APP_DETECTION_WORKER_ENABLED=true
APP_DETECTION_WORKER_DEPLOYMENT=remote
APP_DETECTION_WORKER_LABEL=remote-python-worker

# -------------------- 文件上传路径 --------------------
UPLOAD_ROOT_DIR=./uploads
MODEL_UPLOAD_DIR=./uploads/models
DETECTION_UPLOAD_DIR=./uploads/images
DETECTION_RESULT_DIR=./uploads/results
DETECTION_ANNOTATED_DIR=./uploads/annotated
DEFAULT_MODEL_FILE=2f051822-fa0e-4803-9561-ede47fe3b362.onnx

# -------------------- Chat Assistant --------------------
CHAT_ASSISTANT_ENABLED=true
CHAT_ASSISTANT_DEFAULT_SESSION_SUFFIX=default
CHAT_ASSISTANT_MAX_HISTORY_MESSAGES=30
CHAT_ASSISTANT_VOICE_TRANSCRIBE_URL=http://127.0.0.1:9001/transcribe
CHAT_ASSISTANT_VOICE_TRANSCRIBE_ALLOWED_HOSTS=localhost,127.0.0.1,::1
CHAT_ASSISTANT_VOICE_CONNECT_TIMEOUT_MS=1500
CHAT_ASSISTANT_VOICE_READ_TIMEOUT_MS=30000
CHAT_ASSISTANT_VOICE_MAX_BYTES=10485760

# -------------------- Local ASR (faster-whisper) --------------------
ASR_MODEL=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_MAX_UPLOAD_BYTES=10485760

# -------------------- DeepSeek LLM (多Agent智能路由) --------------------
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=sk-your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Alibaba Cloud AgentScope Java 2.0.1 / AG-UI（与官方 v2 文档对应）
AGENTSCOPE_AI_ENABLED=false
DASHSCOPE_API_KEY=sk-your_dashscope_api_key
AGENTSCOPE_AI_MODEL=dashscope:qwen-plus
AGENTSCOPE_AI_AGENT_ID=doorhandle-assistant
AGENTSCOPE_AI_WORKSPACE=${PWD}/.agentscope/workspace
AGENTSCOPE_AI_MAX_ITERS=12
AGENTSCOPE_AI_ENABLE_REASONING=false
AGENTSCOPE_AI_EMIT_TOKEN_USAGE=false
AGENTSCOPE_AGUI_PATH_PREFIX=/agui
AGENTSCOPE_AGUI_CORS_ENABLED=false

# -------------------- AgentScope 平台扩展（按需配置） --------------------
# 多 Agent 协作 / A2A / Responses API
AGENT_EVENT_BRIDGE_ENABLED=false
AGENT_EVENT_BRIDGE_PROVIDER=local
AGENT_EVENT_BRIDGE_ENDPOINT=
AGENT_EVENT_BRIDGE_API_KEY=
AGENT_A2A_ENABLED=false
AGENT_A2A_ENDPOINT=
AGENT_A2A_API_KEY=
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
AGENT_RESPONSES_ENABLED=false
AGENT_RESPONSES_BASE_URL=https://api.openai.com/v1

# 模型路由：dashscope -> deepseek -> glm（实际调用由 AgentScope 适配器实现）
AGENT_MODEL_PROVIDER=dashscope
AGENT_MODEL_FALLBACK_PROVIDER=deepseek
AGENT_MODEL_TIMEOUT=60s
AGENT_MODEL_MAX_RETRIES=2
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
GLM_API_KEY=your_glm_api_key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# 长期记忆与向量库
AGENT_MEMORY_REDIS_ENABLED=false
AGENT_MEMORY_MEM0_ENABLED=false
MEM0_BASE_URL=http://localhost:8888
MEM0_API_KEY=your_mem0_api_key
AGENT_VECTOR_ENABLED=false
AGENT_VECTOR_PROVIDER=milvus
VECTOR_STORE_URI=http://localhost:19530
VECTOR_STORE_TOKEN=
VECTOR_STORE_COLLECTION=doorhandle_knowledge

# 工作区、沙箱和可观测性
AGENT_WORKSPACE_ROOT=${PWD}/.agentscope/workspace
AGENT_WORKSPACE_SANDBOX=local
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-your_langfuse_public_key
LANGFUSE_SECRET_KEY=sk-your_langfuse_secret_key
LANGFUSE_HOST=http://localhost:3000

# -------------------- Memory Service Embedding --------------------
EMBEDDING_API_KEY=sk-your_embedding_api_key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# -------------------- MyBatis 日志 --------------------
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.slf4j.Slf4jImpl

# -------------------- 日志（默认仅控制台） --------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_WEB=INFO
LOG_LEVEL_JDBC=INFO
