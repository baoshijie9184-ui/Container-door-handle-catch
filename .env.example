# ============================================================
# DoorHandleCatch 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================================================

# -------------------- 数据库 --------------------
DB_URL="jdbc:mysql://localhost:3306/doorhandledb?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8&rewriteBatchedStatements=true"
DB_USERNAME=root
DB_PASSWORD=your_db_password

# -------------------- Redis（缓存、会话及 Agent 记忆） --------------------
# 本地开发默认连接 localhost:6379；生产环境请改为内网地址并填写密码。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2s
REDIS_CONNECT_TIMEOUT=2s
REDIS_POOL_MAX_ACTIVE=16
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=2
REDIS_POOL_MAX_WAIT=2s
SPRING_CACHE_TYPE=redis
REDIS_HEALTH_ENABLED=true
APP_REDIS_ENABLED=true
APP_REDIS_KEY_PREFIX=doorhandlecatch
APP_REDIS_DEFAULT_TTL=30m
APP_REDIS_TTL_DASHBOARD=5m
APP_REDIS_TTL_MODEL=10m
APP_REDIS_TTL_DEVICE=5m
APP_REDIS_TTL_EMPLOYEE=10m
APP_REDIS_TTL_DETECTION_TASK=2m
APP_REDIS_TTL_CHAT_SESSION=15m

# -------------------- JWT --------------------
JWT_SECRET=your_jwt_secret_key_at_least_256_bits
JWT_EXPIRATION=604800

# -------------------- 阿里云 OSS (Java / Python 共用) --------------------
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=handlecatchs
ALIYUN_OSS_ACCESS_KEY_ID=your_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_access_key_secret

# -------------------- Kafka --------------------
# Java 端
APP_KAFKA_ENABLED=true
APP_KAFKA_BOOTSTRAP_SERVERS=10.20.144.118:9092
APP_KAFKA_CONSUMER_GROUP=doorhandlecatch-detection
APP_KAFKA_TOPIC_TASK_CREATED=detection.task.created
APP_KAFKA_TOPIC_TASK_FINISHED=detection.task.finished
APP_KAFKA_TOPIC_TASK_PROGRESS=detection.task.progress
# Python 端 (独立 worker 使用)
KAFKA_BOOTSTRAP_SERVERS=10.20.144.118:9092
KAFKA_TASK_CREATED_TOPIC=detection.task.created
KAFKA_TASK_FINISHED_TOPIC=detection.task.finished
KAFKA_CONSUMER_GROUP=doorhandlecatch-python
KAFKA_DELIVERY_TIMEOUT_SECONDS=10

# -------------------- Detection Worker --------------------
APP_DETECTION_WORKER_ENABLED=true
APP_DETECTION_WORKER_DEPLOYMENT=remote
APP_DETECTION_WORKER_LABEL=remote-python-worker

# -------------------- 文件上传路径 --------------------
UPLOAD_ROOT_DIR=./uploads
MODEL_UPLOAD_DIR=./uploads/models
DETECTION_UPLOAD_DIR=./uploads/images
DETECTION_RESULT_DIR=./uploads/results
DETECTION_ANNOTATED_DIR=./uploads/annotated
DEFAULT_MODEL_FILE=2f051822-fa0e-4803-9561-ede47fe3b362.onnx

# -------------------- Chat Assistant --------------------
CHAT_ASSISTANT_ENABLED=true
CHAT_ASSISTANT_DEFAULT_SESSION_SUFFIX=default
CHAT_ASSISTANT_MAX_HISTORY_MESSAGES=30
CHAT_ASSISTANT_VOICE_TRANSCRIBE_URL=http://127.0.0.1:9001/transcribe
CHAT_ASSISTANT_VOICE_TRANSCRIBE_ALLOWED_HOSTS=localhost,127.0.0.1,::1
CHAT_ASSISTANT_VOICE_CONNECT_TIMEOUT_MS=1500
CHAT_ASSISTANT_VOICE_READ_TIMEOUT_MS=30000
CHAT_ASSISTANT_VOICE_MAX_BYTES=10485760

# -------------------- Local ASR (faster-whisper) --------------------
ASR_MODEL=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_MAX_UPLOAD_BYTES=10485760

# -------------------- DeepSeek LLM (多Agent智能路由) --------------------
DEEPSEEK_API_KEY=sk-your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# AgentScope Java 2.0.4 / AG-UI；默认模型 ID 可为 dashscope:、deepseek:、openai-official:
AGENTSCOPE_AI_ENABLED=false
DASHSCOPE_API_KEY=sk-your_dashscope_api_key
DASHSCOPE_MODEL=qwen-plus
AGENTSCOPE_AI_MODEL=dashscope:qwen-plus
AGENTSCOPE_AI_AGENT_ID=doorhandle-assistant
AGENTSCOPE_AI_WORKSPACE=${PWD}/.agentscope/workspace
AGENTSCOPE_AI_MAX_ITERS=12
AGENTSCOPE_AI_ENABLE_REASONING=false
AGENTSCOPE_AI_EMIT_TOKEN_USAGE=false
AGENTSCOPE_AGUI_PATH_PREFIX=/agui
AGENTSCOPE_AGUI_CORS_ENABLED=false

# 固定 Fetch 本地 Stdio；需显式 V25，安装在用户 workspace/mcp 目录
AGENT_LOCAL_MCP_ENABLED=false
# 显式执行 V34 后可启用，恢复等待中的固定 Fetch 安装；已开始的任务不自动重放
AGENT_MCP_DURABLE_INSTALL_ENABLED=false
AGENT_LOCAL_MCP_PYTHON=python
AGENT_LOCAL_MCP_INSTALLER=${PWD}/script/shell/install-local-fetch-mcp.py

# -------------------- AgentScope 平台扩展（按需配置） --------------------
# 多 Agent 协作 / A2A / Responses API
AGENT_EVENT_BRIDGE_ENABLED=false
AGENT_EVENT_BRIDGE_PROVIDER=local
AGENT_EVENT_BRIDGE_ENDPOINT=
AGENT_EVENT_BRIDGE_API_KEY=
AGENT_A2A_ENABLED=false
AGENT_A2A_ENDPOINT=
AGENT_A2A_API_KEY=
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
AGENT_RESPONSES_BASE_URL=https://api.openai.com/v1
AGENT_RESPONSES_STORE=false
# 可选：兼容平台要求的 x-openai-actor-authorization 请求头
AGENT_RESPONSES_ACTOR_AUTHORIZATION=

# 主站聊天与 AG-UI 均由 AGENTSCOPE_AI_MODEL 选择模型
AGENT_MODEL_TIMEOUT=60s
# 首段文字、思考内容或工具参数超时；空的协议事件不重置计时
AGENT_MODEL_FIRST_TOKEN_TIMEOUT=15s
# 关闭自动备用时才使用同一模型重试；开启时各模型只尝试一次
AGENT_MODEL_MAX_RETRIES=2
AGENT_MODEL_PROXY_URL=
AGENT_MODEL_MAX_OUTPUT_TOKENS=2048
AGENT_MODEL_FALLBACK_ENABLED=false
AGENT_MODEL_FALLBACK_MODEL=deepseek:deepseek-flash
# 多级备用顺序，非空时覆盖上面的单备用字段；开启前配置所有候选的密钥
# 例如 deepseek:deepseek-flash,dashscope:qwen-plus（必须匹配 DASHSCOPE_MODEL）
AGENT_MODEL_FALLBACK_MODELS=
AGENT_MODEL_FAILURE_THRESHOLD=2
AGENT_MODEL_CIRCUIT_COOLDOWN=60s
AGENT_MODEL_QUOTA_COOLDOWN=5m
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GLM_API_KEY=your_glm_api_key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# 长期记忆与向量库
AGENT_MEMORY_REDIS_ENABLED=false
AGENT_MEMORY_MEM0_ENABLED=false
MEM0_BASE_URL=http://localhost:8888
MEM0_API_KEY=your_mem0_api_key
AGENT_VECTOR_ENABLED=false
AGENT_VECTOR_PROVIDER=milvus
VECTOR_STORE_URI=http://localhost:19530
VECTOR_STORE_TOKEN=
VECTOR_STORE_COLLECTION=doorhandle_knowledge

# 工作区、沙箱和可观测性
AGENT_WORKSPACE_ROOT=${PWD}/.agentscope/workspace
AGENT_WORKSPACE_SANDBOX=local
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-your_langfuse_public_key
LANGFUSE_SECRET_KEY=sk-your_langfuse_secret_key
LANGFUSE_HOST=http://localhost:3000

# -------------------- Memory Service Embedding --------------------
EMBEDDING_API_KEY=sk-your_embedding_api_key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# -------------------- MyBatis 日志 --------------------
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.slf4j.Slf4jImpl

# -------------------- 日志（默认仅控制台） --------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_WEB=INFO
LOG_LEVEL_JDBC=INFO

# 执行 sql/mysql/migration-V16-agentscope-run-journal.sql 后启用持久运行与工具事件
AGENT_RUN_JOURNAL_ENABLED=false
# Requires V31 and the run journal. Records private fetched excerpts and source markers.
AGENT_RESEARCH_EVIDENCE_ENABLED=false
# Requires V33; private source export needs an explicit user confirmation.
AGENT_RESEARCH_EXPORT_ENABLED=false
AGENT_CONVERSATION_CONTROL_ENABLED=false
AGENT_WORKBENCH_ENABLED=false
AGENT_WORKBENCH_MAX_FILE_BYTES=26214400
AGENT_WORKBENCH_QUOTA_BYTES=524288000
AGENT_WORKBENCH_PREVIEW_BYTES=64000
AGENT_RESEARCH_EXPORT_RATE_LIMIT_ENABLED=false
AGENT_RESEARCH_EXPORT_MAX_PER_WINDOW=5
AGENT_RESEARCH_EXPORT_WINDOW_SECONDS=60
# Optional in-run AgentScope summarization; no filesystem offload or automatic memory writes.
AGENT_CONTEXT_COMPACTION_ENABLED=false
AGENT_CONTEXT_TRIGGER_MESSAGES=32
AGENT_CONTEXT_TRIGGER_TOKENS=24000
AGENT_CONTEXT_KEEP_MESSAGES=6
AGENT_CONTEXT_MAX_SUMMARY_CHARS=6000
AGENT_CONTEXT_TIMEOUT_SECONDS=12
AGENT_CONTEXT_MAX_PER_RUN=3
# V32: optional account quota and expired source content erasure. Both switches default off.
AGENT_RESEARCH_STORAGE_GOVERNANCE_ENABLED=false
AGENT_RESEARCH_MAX_SOURCES_PER_USER=500
AGENT_RESEARCH_EXPIRED_CONTENT_PURGE_ENABLED=false
AGENT_RESEARCH_CLEANUP_BATCH_SIZE=100
AGENT_RESEARCH_CLEANUP_DELAY_MS=60000
AGENT_SKILL_EVOLUTION_ENABLED=false
# 执行 V19 确认/审计迁移并启用运行日志后，可开放主管质检分配提议
AGENT_ACTION_CONFIRMATION_ENABLED=false

# V26 个人记忆治理与私有 Mem0 桥接；本机迁移脚本可生成，勿提交真实值。
MEM0_BRIDGE_TOKEN=
# Java 调用本项目 Python 私有桥接的地址，区别于上方 SDK 的 MEM0_BASE_URL。
MEM0_SERVICE_URL=http://127.0.0.1:8081
# 服务器可填持久卷目录（如 /srv/doorhandle/mem0），含 Chroma 和原生历史库。
# 留空保留现有本地存储路径；配置新目录不会自动迁移已有数据。
MEM0_DATA_DIR=
MEM0_PROVIDER_TIMEOUT_SECONDS=15
MEM0_WRITE_RESPONSE_SECONDS=3
MEM0_WRITE_REVIEW_SECONDS=120

# V30 报告事件投递、重试和消费回执；先迁移数据库并创建 Kafka topic。
APP_REPORT_EVENTS_ENABLED=false
APP_REPORT_EVENTS_TOPIC=detection.report.lifecycle.v1
APP_REPORT_EVENTS_CONSUMER_GROUP=doorhandlecatch-report-receipts-v1

# Private public-link Skill download (V27, existing evolution required)
AGENT_SKILL_LINK_ENABLED=false
AGENT_SKILL_LINK_PYTHON=python

# Total private downloaded Skill bytes, plus 5 MiB reservation per pending package
AGENT_SKILL_LINK_QUOTA_BYTES=67108864

# 仅清理本人已确认的到期记忆；关闭调度不会取消检索端的停用/到期过滤。
MEM0_LIFECYCLE_CLEANUP_ENABLED=true
MEM0_CLEANUP_INTERVAL_SECONDS=60

# 允许本人主动发起语义记忆审阅；关闭后仍可读取历史、执行已确认的治理。
MEM0_DUPLICATE_REVIEW_ENABLED=true
# 手动语义对比等待上限 1—60 秒，独立于自动提炼的供应商超时。
MEM0_DUPLICATE_REVIEW_TIMEOUT_SECONDS=30
